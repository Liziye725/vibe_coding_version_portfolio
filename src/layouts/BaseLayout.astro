---
import '../styles/global.css';

const { title = 'Ziye Li — Portfolio', description = 'Robotics, machine learning, cloud, and embedded engineering projects' } = Astro.props;
---
<html lang="en" class="bg-slate-950 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <main class="mx-auto flex min-h-screen max-w-5xl flex-col gap-8 px-4 py-10 md:px-8">
      {Astro.url.pathname !== '/' && (
        <a href="/" class="text-sm text-sky-400 hover:text-sky-300 hover:underline">
          Back to home
        </a>
      )}
      <slot />
    </main>
  </body>
</html>
